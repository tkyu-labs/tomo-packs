{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tkyu-labs/tomo-packs/schema/pack.schema.json",
  "title": "Tomo pack manifest (pack.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "school",
    "version",
    "license",
    "publisher",
    "requires",
    "permissions",
    "sources"
  ],
  "$defs": {
    "i18n": {
      "description": "User-facing text in all three Tomo languages.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "ja"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host": {
      "description": "A host name without scheme or path, e.g. syllabus.example.ac.jp. A site that exists once per academic year may write {year} for the four-digit year (moodle{year}.example-u.ac.jp; Tomo matches every year, so a new year needs no pack update). Older Tomo does not know {year} (it matches no page there): skills for such a site should check for a tool only newer Tomo has (tomo_page_image) before opening it.",
      "type": "string",
      "pattern": "^(?=.{1,253}$)(([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?|[a-z0-9-]{0,50}\\{year\\}[a-z0-9-]{0,50})\\.)+[a-z]{2,}$"
    },
    "icon": {
      "type": "string",
      "enum": [
        "book",
        "bell",
        "file",
        "language",
        "calendar",
        "chat",
        "search",
        "shield",
        "key",
        "box",
        "graduation"
      ]
    },
    "prompt": {
      "description": "An example question in all three languages; `skill` when a different skill than the topic's answers it (Tomo's pack overview lists questions by skill).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "ja"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "description": "School domain without the public suffix, e.g. shonan-it for shonan-it.ac.jp. Must equal the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "name": {
      "$ref": "#/$defs/i18n",
      "description": "Full English school name + 'Pack', never an acronym."
    },
    "school": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "short",
        "domain",
        "country"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/i18n"
        },
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Shown where space is tight."
        },
        "domain": {
          "$ref": "#/$defs/host"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "municipalities": {
          "type": "array",
          "description": "Optional. Municipalities near the school (Japan: 6-digit local government codes, 団体コード, the school's own first); Tomo offers them first when it asks where the student lives.",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "$ref": "#/$defs/i18n"
    },
    "license": {
      "const": "MIT",
      "description": "Code licence; written content is CC BY 4.0 (LICENSE-CONTENT.md)."
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "github"
      ],
      "description": "Who publishes the pack; shown in Tomo's pack details and install review.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tomo",
        "hermes"
      ],
      "properties": {
        "tomo": {
          "type": "string",
          "description": "Version range, e.g. >=0.9.0"
        },
        "hermes": {
          "type": "string",
          "description": "Hermes line the pack is tested with, e.g. 0.21.x"
        }
      }
    },
    "permissions": {
      "description": "Shown in Tomo's install review and enforced by Tomo.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "browser_origins",
        "personal_data",
        "computer_use"
      ],
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host"
          },
          "uniqueItems": true
        },
        "browser_origins": {
          "description": "Hosts where Tomo may fill identifiers or logins (with approval).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/host"
          },
          "uniqueItems": true
        },
        "personal_data": {
          "description": "Personal data the pack may send to the model after per-item approval.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "grades",
              "self_assessment",
              "timetable",
              "contact"
            ]
          },
          "uniqueItems": true
        },
        "personal_origins": {
          "description": "Hosts whose pages hold the student's personal data. Tomo shows the model only headings and controls of these pages and asks the student before sending any value read there. Must also be listed in browser_origins.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/host"
          },
          "uniqueItems": true
        },
        "personal_names": {
          "description": "Optional: the name students know each personal_origins host by (\"portal.example-u.ac.jp\": \"CampusSquare\"). Tomo names these systems when it asks once whether it may read personal data, in Settings and in answers that used it; without a name it shows the host.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/host"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "content_images": {
          "description": "Optional: images that may be looked at on a personal_origins site, by URL path pattern (* matches anything), e.g. a quiz's figures or slides in course material: {\"moodle{year}.example-u.ac.jp\": [\"/pluginfile.php/*/question/*\"]}. Tomo fetches only these, with the student's one-time consent, and never takes page screenshots there (they show names). The image itself reaches the model unmasked: list question and material images only, never photos of people. Older Tomo ignores it. New patterns count as added access in an update.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/host"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/[^\\s]*$",
              "maxLength": 120
            }
          }
        },
        "personal_consent": {
          "description": "The Hatch question whose answer can refuse reading personal data at all; with a refusing answer Tomo reads nothing on personal_origins.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "refuse"
          ],
          "properties": {
            "question": {
              "type": "string",
              "description": "Hatch question id (a choice question)."
            },
            "refuse": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true,
              "description": "Option values that refuse."
            }
          }
        },
        "records": {
          "description": "Optional: pages of a personal_origins site that the pack's skills may ask Tomo to keep (encrypted on the student's computer, shown in Memory, deleted when the skill's expiry date passes), so later questions need no new sign-in. Each kind is tied to one site; the skill decides when a page may be kept and until when. Older Tomo ignores it (skills then read the page every time). A new kind counts as added access in an update.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "origin"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
                "maxLength": 60,
                "description": "The record kind the skill names in tomo_records_put / tomo_records_get, e.g. campussquare.self-check."
              },
              "origin": {
                "$ref": "#/$defs/host",
                "description": "The personal_origins site the page is on."
              },
              "label": {
                "$ref": "#/$defs/i18n",
                "description": "What the student sees in Memory (the page's name)."
              }
            }
          },
          "uniqueItems": true
        },
        "computer_use": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official"
      ],
      "properties": {
        "official": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/host"
          },
          "description": "Hosts (and their subdomains) treated as the school's own sources."
        },
        "refresh": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "per_term",
              "monthly",
              "weekly",
              "daily",
              "manual"
            ]
          }
        }
      }
    },
    "skills": {
      "description": "Skill folders under skills/ (Hermes SKILL.md).",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "mcp": {
      "description": "Optional stdio MCP servers under mcp/<name>/, run by Tomo's bundled runtime.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "tools"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Allowlist; other tools of the server are not exposed."
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quick_topics": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "icon",
              "skill",
              "label",
              "description",
              "prompts"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "icon": {
                "$ref": "#/$defs/icon"
              },
              "skill": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "A skill listed in `skills`; the topic or suggestion only exists because this skill can answer it."
              },
              "label": {
                "$ref": "#/$defs/i18n"
              },
              "description": {
                "$ref": "#/$defs/i18n"
              },
              "prompts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "$ref": "#/$defs/prompt"
                }
              },
              "record": {
                "type": "string",
                "description": "Optional: a kind from permissions.records. Tomo then gives the topic a page of its own in the sidebar with that kept record as a status card (when it was read, from where, read again); topics without one are listed in the pack overview only. Older Tomo ignores it."
              }
            }
          }
        },
        "quick_ask_suggestions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "text"
            ],
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "A skill listed in `skills`; the topic or suggestion only exists because this skill can answer it."
              },
              "text": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        }
      }
    }
  }
}
